{
  "name": "rival-grounds",
  "version": "0.1.0",
  "dependencies": [
    {
      "name": "glad",
      "features": [
        "extensions"
      ]
    },
    "glfw3",
    "opengl",
    "glm",
    "zlib",
    "libpng",
    {
      "name": "imgui",
      "features": [
        "glfw-binding",
        "opengl3-binding"
      ]
    }
  ],
  "features": {
    "x11": {
      "description": "GLFW's X11 backend, which is on by default on Linux"
    },
    "wayland": {
      "description": "Enable Wayland support for GLFW",
      "dependencies": [
        {
          "name": "glfw3",
          "features": [
            "wayland"
          ]
        }
      ]
    },
    "windows": {
      "description": "Enable Windows (Win32) support for GLFW",
      "dependencies": [
        {
          "name": "glfw3",
          "platform": "windows"
        }
      ]
    }
  },
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489"
}